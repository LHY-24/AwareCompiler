# Optional API settings for external LLM baselines.
# Copy to .env locally if desired; do not commit secrets.
AWARECOMPILER_LLM_BASE_URL=https://api.openai.com/v1
AWARECOMPILER_LLM_API_KEY=<your-openai-compatible-key>
AWARECOMPILER_LLM_MODEL=gpt-5.5
# Set to false only for trusted private gateways with self-signed certificates.
AWARECOMPILER_LLM_VERIFY_SSL=true
